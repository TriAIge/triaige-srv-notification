# Copie para .env (ja no .gitignore) e preencha com valores reais para rodar localmente.
# NUNCA commitar valores reais (secao 6.3 da spec). Por decisao do usuario, este repositorio
# nao tem pipeline de CI/CD (GitHub Actions) nem usa GitHub Secrets por enquanto - os segredos
# sao passados via .env/variavel de ambiente do container mesmo para o que viria a ser "deploy".

# --- Banco de dados (schema compartilhado `triaige`) ---
DB_URL=jdbc:mysql://localhost:3306/triaige?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=triaige
DB_PASSWORD=changeme

# --- SMTP Gmail (secao 6.2) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
# App Password de 16 digitos (Conta Google > Seguranca > Senhas de app), NAO a senha da conta.
SMTP_APP_PASSWORD=changeme
NOTIFICATION_FROM_NAME=Triaige

# --- Dashboard (fora do escopo desta fase, so a URL e usada no link do e-mail) ---
DASHBOARD_BASE_URL=http://localhost:3000

# --- AWS / SQS (secao 2.1 e 7) ---
# Sem endpoint override: o servico sempre resolve a URL da fila direto na AWS pelo nome
# (GetQueueUrl). Requer credenciais AWS validas no ambiente (perfil, variaveis de ambiente
# padrao do SDK, ou IAM role da instancia em producao).
AWS_REGION=us-east-1
RESULTS_READY_QUEUE_NAME=triaige-results-ready
NOTIFICATION_RETRY_QUEUE_NAME=triaige-notification-retry
NOTIFICATION_RETRY_DLQ_NAME=triaige-notification-retry-dlq
# As filas de retry/DLQ ainda nao existem na AWS (bloqueante externo, secao 11 item 2) - deixe
# desabilitado ate elas serem provisionadas em triaige-infra, senao o consumer loga erro a
# cada poll tentando resolver uma fila inexistente.
RETRY_CONSUMER_ENABLED=true
RESULTS_READY_CONSUMER_ENABLED=true

# --- Observabilidade ---
CLOUDWATCH_METRICS_ENABLED=false
LOG_LEVEL=INFO

SERVER_PORT=8083
